---
import Base from "../layouts/Base.astro";
import GridGlyph from "../components/GridGlyph.astro";

// Step numbers and pictograms on the wordmark's cell grid, so the install
// path reads in the same voice as the mark.
const DIGITS = [
  [".#..", "##..", ".#..", ".#..", "####"],
  ["####", "...#", "####", "#...", "####"],
  ["####", "...#", "####", "...#", "####"],
  ["#..#", "#..#", "####", "...#", "...#"],
];
const ART = {
  terminal: ["#.......", ".#......", "..#.....", ".#......", "#....###"],
  mark: ["####.####", "#..#.#...", "#..#.#...", "#..#.#...", "####.####"],
  phone: ["##.##", "#...#", "#...#", "#...#", "#...#", "#...#", "#####"],
  check: ["......#", ".....#.", "#...#..", ".#.#...", "..#...."],
};
---

<Base
  title="Remote for OpenCode: control your agents from your phone"
  ogTitle="Control your OpenCode agents from your phone"
  description="Your all in one remote control for OpenCode. A native iPhone app connected to your Mac with a single handshake. End-to-end encrypted, no servers, no networking setup."
>
  <section class="hero">
    <h1>Your all in one remote control for OpenCode.<br />Control your agents from your phone.</h1>
    <p class="lede">
      Remote for OpenCode connects your iPhone to your Mac computer with a
      single handshake process, no networking magic required. Take all of your
      OpenCode projects on the go, no more holding your laptop open in the
      coffee shop line!
    </p>
    <div class="actions">
      <a class="button" href="https://apps.apple.com/us/app/remote-for-opencode-agents/id6797660779">Download for iPhone</a>
      <a class="button" href="/download">Download for Mac</a>
      <a class="button secondary" href="https://github.com/tjameswilliams/remote-for-opencode">Read the source</a>
    </div>
    <p class="note" style="margin-top: 1rem;">
      Free and source-available. No servers, no accounts, no telemetry.
      Requires a Mac and <a href="https://opencode.ai">OpenCode</a>.
    </p>
  </section>

  <section class="demos-section">
    <h2>See it work</h2>
    <div class="demos">
      <figure>
        <video
          src="/demos/pairing.mp4"
          poster="/demos/pairing.jpg"
          controls
          muted
          loop
          playsinline
          preload="none"
        ></video>
        <figcaption>
          <strong>Pairing</strong>
          Confirm a six-digit code on both screens. No accounts, no addresses.
        </figcaption>
      </figure>
      <figure>
        <video
          src="/demos/coding.mp4"
          poster="/demos/coding.jpg"
          controls
          muted
          loop
          playsinline
          preload="none"
        ></video>
        <figcaption>
          <strong>A session</strong>
          Slash commands, live thinking, and tool calls as they happen.
        </figcaption>
      </figure>
      <figure>
        <video
          src="/demos/diff.mp4"
          poster="/demos/diff.jpg"
          controls
          muted
          loop
          playsinline
          preload="none"
        ></video>
        <figcaption>
          <strong>Reviewing changes</strong>
          Every accumulated change, per file, line by line.
        </figcaption>
      </figure>
    </div>
  </section>

  <div class="shots">
    <img src="/shots/01.png" alt="A coding agent working on a fix, with its plan and streamed answer" loading="lazy" />
    <img src="/shots/02.png" alt="An approval prompt for a risky shell command" loading="lazy" />
    <img src="/shots/03.png" alt="A file diff shown line by line" loading="lazy" />
    <img src="/shots/04.png" alt="Plan mode proposing changes without editing anything" loading="lazy" />
  </div>

  <section class="grid">
    <div class="card">
      <h3>No servers, including ours</h3>
      <p>
        Traffic is end-to-end encrypted between your two devices. There is
        nothing in the middle, because there is nothing to be in the middle.
      </p>
    </div>
    <div class="card">
      <h3>No networking homework</h3>
      <p>
        No VPN, no port forwarding, no IP addresses. Your devices find each
        other through your own iCloud account and talk directly.
      </p>
    </div>
    <div class="card">
      <h3>Approvals that vary with risk</h3>
      <p>
        A <code>git status</code> and an <code>rm -rf</code> should not look
        the same. Destructive commands get a louder card and no blanket allow.
      </p>
    </div>
    <div class="card">
      <h3>Plan mode</h3>
      <p>
        Switch the agent to Plan and it cannot edit anything at all. Explore
        and get a plan back, guaranteed nothing changed.
      </p>
    </div>
    <div class="card">
      <h3>Review before you sign off</h3>
      <p>
        Every accumulated change, per file, against your last commit or your
        default branch, the way a reviewer would see it.
      </p>
    </div>
    <div class="card">
      <h3>Your credentials stay put</h3>
      <p>
        The agent uses the model providers you configured on your Mac. Their
        keys never leave it and the phone never sees them.
      </p>
    </div>
  </section>

  <section class="prose steps-section">
    <h2>Zero to paired</h2>
    <p>From nothing installed to steering your agent, in four steps.</p>
    <ol class="steps">
      <li>
        <span class="step-digit"><GridGlyph rows={DIGITS[0]} height={35} label="Step 1" /></span>
        <div class="step-body">
          <h3>Install OpenCode</h3>
          <pre><code>curl -fsSL https://opencode.ai/install | bash</code></pre>
          <p class="note">Already running <a href="https://opencode.ai">OpenCode</a>? Skip ahead.</p>
        </div>
        <span class="step-art"><GridGlyph rows={ART.terminal} height={40} /></span>
      </li>
      <li>
        <span class="step-digit"><GridGlyph rows={DIGITS[1]} height={35} label="Step 2" /></span>
        <div class="step-body">
          <h3>Install the Mac companion</h3>
          <pre><code>brew install --cask tjameswilliams/tap/remote-for-opencode</code></pre>
          <p class="note">
            Or <a href="/download">download the .dmg</a>. It keeps
            <code>opencode serve</code> on localhost, never exposed to your
            network, and is the only gateway to it.
          </p>
        </div>
        <span class="step-art"><GridGlyph rows={ART.mark} height={40} /></span>
      </li>
      <li>
        <span class="step-digit"><GridGlyph rows={DIGITS[2]} height={35} label="Step 3" /></span>
        <div class="step-body">
          <h3>Get the iPhone app</h3>
          <div class="actions">
            <a class="button" href="https://apps.apple.com/us/app/remote-for-opencode-agents/id6797660779">Download on the App Store</a>
          </div>
          <p class="note">Free. A 1.5 MB download.</p>
        </div>
        <span class="step-art"><GridGlyph rows={ART.phone} height={48} /></span>
      </li>
      <li>
        <span class="step-digit"><GridGlyph rows={DIGITS[3]} height={35} label="Step 4" /></span>
        <div class="step-body">
          <h3>Confirm the six-digit code</h3>
          <p>
            Open both apps; when the codes match, you're paired. No accounts,
            no network setup. Background the phone app any time: the agent
            keeps working and the turn picks up when you come back.
          </p>
        </div>
        <span class="step-art"><GridGlyph rows={ART.check} height={32} /></span>
      </li>
    </ol>
  </section>
</Base>
