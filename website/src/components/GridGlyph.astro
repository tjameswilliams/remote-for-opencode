---
// A pictogram on the same square-cell grid as the wordmark and icon: rows of
// '#' (inked) and '.' (empty) cells, rendered exactly like Wordmark.astro and
// scaled so the tallest row count still lands on whole-pixel cells. Decorative
// by default; pass a label to expose it to assistive tech.
interface Props {
  rows: string[];
  height?: number;
  label?: string;
}
const { rows, height = 30, label } = Astro.props;

const cells: [number, number][] = [];
rows.forEach((line, row) =>
  [...line].forEach((mark, col) => {
    if (mark === "#") cells.push([col, row]);
  }),
);
const w = Math.max(...rows.map((r) => r.length));
const h = rows.length;
const cell = Math.max(1, Math.round(height / h));
---

<svg
  width={cell * w}
  height={cell * h}
  viewBox={`0 0 ${w} ${h}`}
  shape-rendering="crispEdges"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {cells.map(([cx, cy]) => <rect x={cx} y={cy} width="1" height="1" fill="currentColor" />)}
</svg>
